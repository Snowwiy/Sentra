# Copy to .env (scripts/setup_windows.ps1 does it and generates a random password).
# Never commit .env.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Native PostgreSQL. scripts/init_database.ps1 creates this role and both databases.
DATABASE_URL=postgresql+psycopg://sentra:change-me@127.0.0.1:5432/sentra
TEST_DATABASE_URL=postgresql+psycopg://sentra:change-me@127.0.0.1:5432/sentra_test

# Shared secret agents present to enroll (min 24 chars). Unset disables enrollment.
# setup_windows.ps1 generates a random value. Give it only to hosts you want to monitor.
AGENT_ENROLLMENT_KEY=change-me-enrollment-key
# Recommended for new agents instead of the shared key above: one-time enrollment tokens
# (`python -m app.cli create-enrollment-token` from backend/). Lifetime in minutes:
# ENROLLMENT_TOKEN_TTL_MINUTES=15
# LEGACY (Fase 4G): operator key for the administration API (X-Admin-Key), only for
# automation scripts on the server. The dashboard uses login + roles and never sees it.
# Unset keeps those endpoints disabled. Never commit a real value.
# ADMIN_API_KEY=
# Dashboard login (Fase 4G, docs/authentication.md). Create the first admin with
# `python -m app.cli create-admin` from backend/. Sessions: absolute and idle lifetime.
# SESSION_TTL_HOURS=12
# SESSION_IDLE_MINUTES=60
# Secure cookie: unset = only with ENVIRONMENT=production. Production must be served over
# HTTPS (reverse proxy); plain HTTP on the LAN is for development only.
# SESSION_COOKIE_SECURE=
# Login brute-force limits (per user+address, per address, per user) in a window.
# LOGIN_RATE_WINDOW_MINUTES=15
# LOGIN_MAX_FAILURES_PER_USER_IP=5
# LOGIN_MAX_ATTEMPTS_PER_IP=30
# LOGIN_MAX_FAILURES_PER_USER=50
# POST /agents/register per address and minute (heartbeats are never limited).
# AGENT_REGISTER_MAX_PER_MINUTE=30
# Accepted Host header names (recommended in production), e.g. sentra.lan,192.168.1.10
# ALLOWED_HOSTS=
# URL agents use to reach this server, shown in the install command (default: suggested
# from this machine's addresses). En producción (Fase 4M) debe ser https:// (el proxy).
# AGENT_SERVER_URL=https://sentra.empresa.lan

# Comma separated origins allowed to call the API from a browser (Vite dev server). Also
# the origins accepted on login and on every state-changing request (CSRF check). Never "*".
# Add the dashboard URL other LAN machines use when it differs from the API's own origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seconds without heartbeat/telemetry before an asset is reported offline.
HEARTBEAT_TIMEOUT_SECONDS=90

# Alert thresholds (percent). CPU/RAM must stay above them for N consecutive samples.
ALERT_CPU_PERCENT=90
ALERT_RAM_PERCENT=90
ALERT_DISK_PERCENT=90
ALERT_SUSTAINED_SAMPLES=3

# Services whose stop opens an alert (comma separated; empty disables). Services set to
# "disabled" are skipped, e.g. WinDefend when a third-party antivirus replaces it.
# ALERT_WATCHED_SERVICES=EventLog,WinDefend,mpssvc
# Events that open an alert on their own, as Provider:EventID (default: unexpected shutdown
# and log cleared).
# ALERT_CRITICAL_EVENTS=Microsoft-Windows-Kernel-Power:41,EventLog:6008,Microsoft-Windows-Eventlog:1102,Microsoft-Windows-Eventlog:104
# Error/critical events from one asset within the window that open a burst alert.
# ALERT_EVENT_BURST_COUNT=10
# ALERT_EVENT_BURST_MINUTES=10
# Event-based alerts resolve after this many minutes without firing again.
# ALERT_EVENT_QUIET_MINUTES=60

# Retention in days (optional). Unset keeps the data forever (the default). Alert retention
# only deletes resolved alerts; active ones are never deleted. Old rows are removed hourly in
# small batches; `python -m app.cli purge-old-data` (from backend/) runs the same purge on
# demand.
# TELEMETRY_RETENTION_DAYS=90
# EVENT_RETENTION_DAYS=180
# CHANGE_RETENTION_DAYS=365
# ALERT_RETENTION_DAYS=365

# Agentless network discovery (docs/discovery.md). Off while the list is empty. Only these
# networks are ever probed (TCP connect, ping, ARP table, reverse DNS); Internet ranges and
# networks over DISCOVERY_MAX_HOSTS_PER_NETWORK addresses are refused. Runs are started from
# the Red page (admin or analyst role), periodically with an interval, or with
# `python -m app.cli discover` from backend/ (admin/debug).
# DISCOVERY_ALLOWED_NETWORKS=192.168.1.0/24,10.0.10.0/24
# DISCOVERY_EXCLUDED=192.168.1.250
# DISCOVERY_PORTS=common
# DISCOVERY_INTERVAL_MINUTES=60
# Identificación (Fase 4E): sondas de nombre mDNS/NetBIOS/SSDP-UPnP a hosts vivos, y base OUI
# local del IEEE para el fabricante de la NIC (vacía: fabricante desconocido).
# DISCOVERY_IDENTIFY=true
# DISCOVERY_OUI_FILE=C:\ProgramData\Sentra\oui\oui.csv

# Motor de detección y correlación (Fase 4H, docs/detection-engine.md). Activo por defecto.
# Solo las detecciones de esta severidad o más abren una alerta (medium, high, critical, off).
# DETECTION_ENABLED=true
# DETECTION_EVAL_INTERVAL_SECONDS=5
# DETECTION_AUTH_FAILURE_THRESHOLD=5
# DETECTION_AUTH_FAILURE_WINDOW_MINUTES=5
# DETECTION_CORRELATION_WINDOW_MINUTES=15
# DETECTION_CHANGE_WINDOW_MINUTES=60
# DETECTION_ALERT_MIN_SEVERITY=high
# DETECTION_DISABLED_RULES=
# Purga detecciones resueltas más antiguas (sin definir = se conservan). Las abiertas nunca.
# DETECTION_RETENTION_DAYS=365

# Reglas personalizadas y Sigma (Fase 5A, docs/custom-detection-rules.md).
# Confianza de las reglas Sigma importadas (low o medium; Sigma no la define).
# SIGMA_DEFAULT_CONFIDENCE=low
# Prueba contra histórico (solo admin): horas, filas examinadas, segundos y pruebas/minuto.
# RULE_TEST_MAX_HOURS=72
# RULE_TEST_MAX_ROWS=20000
# RULE_TEST_TIMEOUT_SECONDS=10
# RULE_TEST_PER_MINUTE=6

# Risk Engine (Fase 4I, docs/risk-engine.md). Activo por defecto; nunca recalcula por heartbeat.
# Umbrales de nivel: inicio de bajo, medio, alto y crítico (0-19 informativo).
# RISK_ENABLED=true
# RISK_EVAL_INTERVAL_SECONDS=15
# RISK_DECAY_INTERVAL_MINUTES=15
# RISK_LEVEL_THRESHOLDS=20,40,60,80
# RISK_ACTIVITY_HALF_LIFE_HOURS=24
# RISK_RESOLVED_HALF_LIFE_HOURS=12
# RISK_RESOLVED_MEMORY_HOURS=72
# Alerta risk_critical solo al cruzar hacia crítico, con cooldown por activo.
# RISK_ALERT_ENABLED=true
# RISK_ALERT_COOLDOWN_HOURS=6
# Purga historial de riesgo más antiguo (sin definir = se conserva).
# RISK_HISTORY_RETENTION_DAYS=365

# Vulnerability & Exposure Management (Fase 5B, docs/vulnerability-management.md). Solo
# catálogos LOCALES importados por un admin; Sentra no descarga ni consulta fuentes externas.
# VULN_ENABLED=true
# VULN_EVAL_INTERVAL_SECONDS=30
# VULN_FULL_REFRESH_HOURS=24
# VULN_BATCH_SIZE=50
# Inventario más antiguo que esto: evidencia antigua (aviso; nunca resuelve nada).
# VULN_STALE_INVENTORY_HOURS=72
# Capturas completas sin el componente antes de resolver por desinstalación.
# VULN_MISSING_THRESHOLD=2
# Catálogo: tamaño máximo (la API además respeta MAX_REQUEST_BYTES), registros y lote CLI.
# VULN_CATALOG_MAX_MB=64
# VULN_CATALOG_MAX_RECORDS=200000
# VULN_IMPORT_BATCH_SIZE=1000
# Alertas internas solo por cambios relevantes (nunca por findings potenciales).
# VULN_ALERT_ENABLED=true
# VULN_ALERT_COOLDOWN_HOURS=24

# Threat Intelligence (Fase 5C, docs/threat-intelligence.md). Offline-first: sin fuentes Sentra
# funciona igual. Las descargas por red (CISA KEV, FIRST EPSS) están APAGADAS; los ficheros se
# pueden importar con `python -m app.cli threat-intel-import`. La API nunca acepta URLs.
# THREAT_INTEL_ENABLED=true
# THREAT_INTEL_SYNC_ENABLED=false
# URL de una fuente si no es la oficial (espejo interno): clave=https://...,clave2=https://...
# THREAT_INTEL_SOURCE_URLS=
# Redes privadas permitidas como destino de descarga (por defecto ninguna).
# THREAT_INTEL_ALLOWED_NETWORKS=
# THREAT_INTEL_DEFAULT_INTERVAL_HOURS=24
# THREAT_INTEL_HTTP_TIMEOUT_SECONDS=120
# THREAT_INTEL_MAX_DOWNLOAD_MB=128
# THREAT_INTEL_MAX_RECORDS=1000000
# THREAT_INTEL_BATCH_SIZE=5000
# Cuándo un match de IOC crea la detección TI-001: off, high_confidence_malicious o malicious.
# THREAT_INTEL_DETECTION_POLICY=high_confidence_malicious
# THREAT_INTEL_EVAL_INTERVAL_SECONDS=60

# AI Security Insights (Fase 4J, docs/ai-security-insights.md). Apagado por defecto: Sentra
# funciona completo sin IA. Solo análisis bajo demanda; nunca en la ingesta.
# AI_ENABLED=false
# Recomendado: Local AI (Ollama, llama.cpp server, vLLM...) con API compatible OpenAI en /v1.
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MODEL=
# Opcional: los servidores locales no la necesitan. Solo servidor; nunca llega al navegador.
# AI_API_KEY=
# Externos bloqueados salvo permiso explícito (sin fallback cloud nunca).
# AI_ALLOW_EXTERNAL=false
# Red privada autorizada para un servidor de IA en la LAN (una IP privada fuera de aquí es externa).
# AI_LOCAL_NETWORKS=192.168.10.0/24
# Nombres del servidor de IA; deben resolver a loopback o a AI_LOCAL_NETWORKS.
# AI_LOCAL_HOSTS=servidor-ia
# Seudonimizar antes de enviar: usernames,hostnames,ips,paths
# AI_REDACT=
# AI_TIMEOUT_SECONDS=60
# AI_MAX_CONTEXT_ITEMS=40
# AI_RATE_LIMIT_PER_USER_PER_MINUTE=6
# AI_RATE_LIMIT_GLOBAL_PER_MINUTE=30
# AI_MAX_CONCURRENT=2

# Gestor de modelos locales (Fase 4J.2, docs/local-model-manager.md).
# Runtime local: llama_cpp, ollama, vllm u openai_compatible (genérico).
# AI_RUNTIME=openai_compatible
# Raíces permitidas para importar .gguf, separadas por ";" (vacío = no se importa nada).
# AI_MODEL_DIRECTORIES=D:\Models;C:\IA\gguf
# AI_MODEL_MAX_FILE_GB=256
# JSON con modelos extra para el catálogo de recomendaciones.
# AI_MODEL_CATALOG_FILE=
# Contexto operativo para recomendar (el análisis normal de Sentra no necesita 100K+).
# AI_DEFAULT_CONTEXT_TOKENS=16384
# AI_MEMORY_SAFETY_MARGIN_PERCENT=10
# AI_BENCHMARK_MAX_TOKENS=128
# AI_BENCHMARK_TIMEOUT_SECONDS=180
# Umbrales tok/s para Excelente, Bueno y Usable (por debajo: Lento).
# AI_PERFORMANCE_THRESHOLDS=30,15,7

# Producción y servidor central (Fase 4M, docs/production-deployment.md).
# Con ENVIRONMENT=production la API se niega a arrancar si algo es inseguro; revisa antes con
# `python -m app.cli production-check` (desde backend/). Secretos nuevos:
# `python -m app.cli generate-secret`. Este archivo (.env) con permisos 600 / ACL restringida.
# Proxies (Caddy/nginx) cuyas cabeceras X-Forwarded-For/Proto se aceptan. Solo IPs o redes;
# un cliente directo nunca puede falsear su IP ni el esquema.
# TRUSTED_PROXIES=127.0.0.1,::1
# Rate limiting: auto = PostgreSQL en producción (compartido entre workers y reinicios),
# memoria en desarrollo. Valores: auto, memory, database.
# RATE_LIMIT_BACKEND=auto
# Límites por usuario y minuto del dashboard (mutaciones y búsquedas con ?q=).
# API_MUTATIONS_PER_USER_PER_MINUTE=120
# API_SEARCHES_PER_USER_PER_MINUTE=120
# Pool de conexiones de la API (por worker) y tiempos máximos.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_SECONDS=10
# DB_POOL_RECYCLE_SECONDS=1800
# DB_CONNECT_TIMEOUT_SECONDS=5
# Cancela consultas de la API que superen N segundos (vacío = sin límite; migraciones aparte).
# DB_STATEMENT_TIMEOUT_SECONDS=30
# Logs: json (producción) o text (consola). LOG_FILE activa rotación propia (Windows Server);
# en Linux con systemd basta stdout/journald.
# LOG_FORMAT=json
# LOG_FILE=C:\ProgramData\Sentra\logs\sentra.log
# LOG_FILE_MAX_MB=50
# LOG_FILE_BACKUPS=10
# Métricas Prometheus en /api/v1/metrics: apagadas por defecto; solo desde estas redes y,
# si se define, con "Authorization: Bearer <METRICS_TOKEN>" (mín. 32 caracteres).
# METRICS_ENABLED=false
# METRICS_ALLOWED_NETWORKS=127.0.0.1,::1
# METRICS_TOKEN=
# Copias de seguridad (docs/backup-restore.md): ruta absoluta fuera del repo y del webroot.
# BACKUP_DIR=/var/backups/sentra
# BACKUP_RETENTION_DAYS=14
# Carpeta de pg_dump/pg_restore si no están en el PATH (Windows: ...\PostgreSQL\18\bin).
# PG_BIN_DIR=
# Build del frontend que sirve el proxy (por defecto frontend/dist); lo revisa production-check.
# FRONTEND_DIST_DIR=
