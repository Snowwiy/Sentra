# Copy to .env (scripts/setup_windows.ps1 does it and generates a random password).
# Never commit .env.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Native PostgreSQL. scripts/init_database.ps1 creates this role and both databases.
DATABASE_URL=postgresql+psycopg://sentra:change-me@127.0.0.1:5432/sentra
TEST_DATABASE_URL=postgresql+psycopg://sentra:change-me@127.0.0.1:5432/sentra_test

# Shared secret agents present to enroll (min 24 chars). Unset disables enrollment.
# setup_windows.ps1 generates a random value. Give it only to hosts you want to monitor.
AGENT_ENROLLMENT_KEY=change-me-enrollment-key

# Comma separated origins allowed to call the API from a browser (Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seconds without heartbeat/telemetry before an asset is reported offline.
HEARTBEAT_TIMEOUT_SECONDS=90

# Alert thresholds (percent). CPU/RAM must stay above them for N consecutive samples.
ALERT_CPU_PERCENT=90
ALERT_RAM_PERCENT=90
ALERT_DISK_PERCENT=90
ALERT_SUSTAINED_SAMPLES=3

# Services whose stop opens an alert (comma separated; empty disables). Services set to
# "disabled" are skipped, e.g. WinDefend when a third-party antivirus replaces it.
# ALERT_WATCHED_SERVICES=EventLog,WinDefend,mpssvc
# Events that open an alert on their own, as Provider:EventID (default: unexpected shutdown
# and log cleared).
# ALERT_CRITICAL_EVENTS=Microsoft-Windows-Kernel-Power:41,EventLog:6008,Microsoft-Windows-Eventlog:1102,Microsoft-Windows-Eventlog:104
# Error/critical events from one asset within the window that open a burst alert.
# ALERT_EVENT_BURST_COUNT=10
# ALERT_EVENT_BURST_MINUTES=10
# Event-based alerts resolve after this many minutes without firing again.
# ALERT_EVENT_QUIET_MINUTES=60

# Retention in days (optional). Unset keeps the data forever (the default). Alert retention
# only deletes resolved alerts; active ones are never deleted. Old rows are removed hourly in
# small batches; `python -m app.cli purge-old-data` (from backend/) runs the same purge on
# demand.
# TELEMETRY_RETENTION_DAYS=90
# EVENT_RETENTION_DAYS=180
# CHANGE_RETENTION_DAYS=365
# ALERT_RETENTION_DAYS=365
