# Sentra con nginx (alternativa a Caddy; Fase 4M). Caddy es la opción recomendada
# (deploy/caddy/Caddyfile.example): renueva certificados y trae TLS seguro por defecto.
# Copiar a /etc/nginx/conf.d/sentra.conf, ajustar nombre, certificados y rutas.
# Validar con: nginx -t

server {
    listen 80;
    listen [::]:80;
    server_name sentra.empresa.lan;
    # Solo redirección: el login nunca viaja por HTTP.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name sentra.empresa.lan;

    ssl_certificate     /etc/nginx/certs/sentra.crt;
    ssl_certificate_key /etc/nginx/certs/sentra.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    server_tokens off;

    # Solo con un certificado válido (nunca en pruebas ni desarrollo).
    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 4m;   # = MAX_REQUEST_BYTES

    location = /api/v1/metrics { return 404; }

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        # $remote_addr (no $proxy_add_x_forwarded_for): se descarta lo que envíe el cliente.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 300s;   # IA local
        proxy_send_timeout 60s;
    }

    root /opt/sentra/frontend/dist;
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }
    location ~ \.map$ { return 404; }
    location / {
        add_header Cache-Control "no-cache" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        try_files $uri /index.html;
    }
}
