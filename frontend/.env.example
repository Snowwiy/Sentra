# Sentra frontend configuration. Copy to .env.local and adjust as needed.

# Base URL of the Sentra API as seen by the browser. Leave empty in development
# to use the Vite proxy below (same origin, no CORS needed). Set it when the
# frontend is served separately, e.g. https://sentra.example.internal
VITE_API_BASE_URL=

# Development only: backend address the Vite dev server proxies /api to.
SENTRA_API_PROXY_TARGET=http://localhost:8000

# Development only: port for the Vite dev server.
SENTRA_FRONTEND_PORT=5173

# Dashboard auto-refresh interval in seconds (minimum 5).
VITE_REFRESH_INTERVAL_SECONDS=15
