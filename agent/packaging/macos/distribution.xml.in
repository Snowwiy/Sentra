<?xml version="1.0" encoding="utf-8"?>
<!--
  Sentra Agent @VERSION@ para macOS @ARCH@ (Fase 6C.5). Plantilla de build-pkg.sh.
  hostArchitectures impide instalar el paquete de una arquitectura en la otra (el de arm64
  en un Intel, o el de x86_64 en Apple Silicon, donde correría bajo Rosetta 2).
-->
<installer-gui-script minSpecVersion="2">
  <title>Sentra Agent @VERSION@</title>
  <options customize="never" require-scripts="true" rootVolumeOnly="true" hostArchitectures="@ARCH@"/>
  <domains enable_localSystem="true" enable_anywhere="false" enable_currentUserHome="false"/>
  <volume-check>
    <allowed-os-versions>
      <os-version min="@MIN_MACOS@"/>
    </allowed-os-versions>
  </volume-check>
  <choices-outline>
    <line choice="default">
      <line choice="com.sentra.agent"/>
    </line>
  </choices-outline>
  <choice id="default"/>
  <choice id="com.sentra.agent" visible="false">
    <pkg-ref id="com.sentra.agent"/>
  </choice>
  <pkg-ref id="com.sentra.agent" version="@VERSION@" onConclusion="none">com.sentra.agent.pkg</pkg-ref>
</installer-gui-script>
