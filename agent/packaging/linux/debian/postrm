#!/bin/sh
# `apt remove` keeps configuration, identity and logs (reinstall = same asset).
# `apt purge` deletes them and the service user.
set -e
if [ -d /run/systemd/system ]; then
  systemctl daemon-reload || true
fi
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
  # The launcher is generated by postinst (it records the python3 path), so dpkg does not
  # own it: remove it with the package.
  rm -f /opt/sentra-agent/bin/sentra-agent
  rmdir /opt/sentra-agent/bin /opt/sentra-agent 2>/dev/null || true
fi
if [ "$1" = "purge" ]; then
  rm -rf /etc/sentra-agent /var/lib/sentra-agent /var/log/sentra-agent /opt/sentra-agent
  if getent passwd sentra-agent >/dev/null 2>&1; then
    userdel sentra-agent || true
  fi
fi
exit 0
